# Copy this file to ".env" and change the values.
# cp .env.example .env

# Port the server listens on
PORT=4000

# Secret used to sign login tokens (JWT). Use a long random string in real life!
JWT_SECRET=change-me-to-a-long-random-string
# How long a login token stays valid
JWT_EXPIRES_IN=7d

# Postgres connection string (required).
# Supabase: Project -> Connect -> "Session pooler" string. Put your real password in it.
# Example: postgresql://postgres.abcdefgh:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# For a Postgres on your own computer:  postgres://postgres:postgres@localhost:5432/raphai
DATABASE_URL=

# SSL is on by default (Supabase needs it). It is off automatically for localhost.
# Set DATABASE_SSL=false only if your own Postgres server has no SSL.
# DATABASE_SSL=false

# How many database connections to keep open (Supabase free plan: keep this small)
# PG_POOL_MAX=5

# Timezone used to decide what "today" means
APP_TZ=Asia/Kolkata

# Which websites may call this API (comma separated). "*" = everyone (fine for development)
CORS_ORIGIN=*

# "development" turns on the /api/subscription/dev-activate shortcut. Use "production" when live.
NODE_ENV=development

# ---- Razorpay (payments) ----
# Leave empty to use STUB mode (fake orders, nothing is charged).
# Get real keys from https://dashboard.razorpay.com -> Settings -> API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you type when creating a webhook in the Razorpay dashboard
RAZORPAY_WEBHOOK_SECRET=
