# Copy this file to ".env" and change the values.
# cp .env.example .env

# Port the server listens on
PORT=4000

# Secret used to sign login tokens (JWT, HS256). Required; at least 32 characters in production.
# Make one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# How long a login token stays valid
JWT_EXPIRES_IN=7d

# Postgres connection string (required).
# Supabase: Project -> Connect -> "Session pooler" string. Put your real password in it.
# Example: postgresql://postgres.abcdefgh:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# For a Postgres on your own computer:  postgres://postgres:postgres@localhost:5432/raphai
DATABASE_URL=

# SSL is on by default (Supabase needs it). It is off automatically for localhost.
# Set DATABASE_SSL=false only if your own Postgres server has no SSL.
# DATABASE_SSL=false

# How many database connections to keep open (Supabase free plan: keep this small)
# PG_POOL_MAX=5

# Timezone used to decide what "today" means
APP_TZ=Asia/Kolkata

# Browser origins allowed to call the API (comma separated). Empty = none (the Android app
# does not need CORS). "*" works only in development/test; it is ignored in production.
CORS_ORIGIN=

# "development" turns on the /api/subscription/dev-activate shortcut. Use "production" when live.
NODE_ENV=development

# ---- Google Play Billing (real payments for the Android app) ----
# The service-account key file from Google Cloud (see the owner checklist).
# Paste the WHOLE JSON on one line, or the file as base64:  base64 -w0 key.json
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PACKAGE_NAME=com.raphai.app
# Real-time Developer Notifications (Pub/Sub push). Long random text; the push URL is
#   https://raphai-backend.onrender.com/api/subscription/google/rtdn?secret=<GOOGLE_RTDN_SECRET>
GOOGLE_RTDN_SECRET=
# Optional extra check of Pub/Sub's signed token (leave empty to skip)
GOOGLE_RTDN_AUDIENCE=
GOOGLE_RTDN_SERVICE_ACCOUNT_EMAIL=

# How many proxies sit in front of the server (Render: 1). Used to read the
# user's real IP for security logs and the /delete-account rate limit.
TRUST_PROXY_HOPS=1

# Optional: Supabase CA certificate (PEM or base64) -> full TLS certificate checking for the DB
DATABASE_SSL_CA=

# ---- AI coach (Gemini). Empty = rule-based coach only. Server-side only, never in the app. ----
GEMINI_API_KEY=
# Optional per-plan model override (Gemini 2.5 models are restricted for new projects)
# GEMINI_MODEL_PLUS=gemini-3.5-flash-lite
# GEMINI_MODEL_PRO=
# GEMINI_MODEL_ELITE=

# Optional rate-limit overrides (requests per minute)
# API_RATE_LIMIT_PER_MIN=600
# COACH_RATE_LIMIT_PER_MIN=30

# ---- Owner admin dashboard (/admin) ----
# Who may sign in (comma separated). Default: rooppashalemraju@gmail.com
ADMIN_EMAILS=rooppashalemraju@gmail.com
# Extra admin step after the normal login: "email" (6-digit code, needs RESEND_API_KEY + EMAIL_FROM)
# or "password" (bcrypt hash of a separate admin password in ADMIN_PASSWORD_HASH).
# Unset = email if email is configured, else password if the hash is set, else admin sign-in is off.
# ADMIN_SECOND_FACTOR=
# Make a hash: node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 12))" 'your admin password'
ADMIN_PASSWORD_HASH=
# ADMIN_SESSION_MINUTES=30
# ADMIN_RATE_LIMIT_PER_MIN=120
