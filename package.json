{
  "name": "raphai-backend",
  "version": "1.0.0",
  "description": "HeartPurse - health + wealth tracking backend (India, INR). Node.js + Express + PostgreSQL.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node test/smoke.js && node test/security.js && node test/admin.js && node test/google.js && node test/food_photo.js && node test/coach.js",
    "test:coach": "node test/coach.js",
    "test:food-photo": "node test/food_photo.js",
    "test:google": "node test/google.js",
    "test:admin": "node test/admin.js",
    "test:security": "node test/security.js",
    "test:body": "node --test test/body_engine.js",
    "test:wealth": "node --test test/wealth_calc.js && node --test test/wealth_api.js",
    "test:accuracy": "node --test test/accuracy.js && node --test test/accuracy_api.js"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "google-auth-library": "^11.2.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "marked": "^15.0.12",
    "pg": "^8.23.1",
    "sharp": "^0.34.5"
  }
}
